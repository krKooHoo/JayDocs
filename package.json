{
  "name": "jaydocs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Markdown(+Mermaid) 과 TSV 를 나란히 편집하는 경량 로컬 문서 편집기",
  "scripts": {
    "dev": "vite",
    "serve": "node server.mjs --dev --port 5190 --token dev",
    "build": "tsc -b && vite build",
    "start": "node server.mjs --open",
    "test": "vitest run",
    "shortcuts": "node scripts/gen-shortcuts.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "flexlayout-react": "^0.11.1",
    "mermaid": "^12.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
